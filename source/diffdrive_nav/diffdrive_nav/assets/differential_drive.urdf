<?xml version="1.0"?>
<robot name="training_diffdrive">
  <material name="body_blue"><color rgba="0.08 0.28 0.65 1.0"/></material>
  <material name="wheel_black"><color rgba="0.03 0.03 0.03 1.0"/></material>
  <material name="sensor_gray"><color rgba="0.25 0.25 0.25 1.0"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="8.0"/>
      <inertia ixx="0.055" ixy="0" ixz="0" iyy="0.085" iyz="0" izz="0.120"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.38 0.30 0.16"/></geometry>
      <material name="body_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.38 0.30 0.16"/></geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00062" ixy="0" ixz="0" iyy="0.00062" iyz="0" izz="0.00022"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.035"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.035"/></geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.35"/>
      <inertia ixx="0.00062" ixy="0" ixz="0" iyy="0.00062" iyz="0" izz="0.00022"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.035"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.055" length="0.035"/></geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="0 0.1675 0.055" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3.0" velocity="40.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="0 -0.1675 0.055" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="3.0" velocity="40.0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>

  <link name="caster_fork">
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.00008" ixy="0" ixz="0" iyy="0.00008" iyz="0" izz="0.00008"/>
    </inertial>
    <visual>
      <origin xyz="-0.025 0 -0.012" rpy="0 0 0"/>
      <geometry><box size="0.055 0.035 0.015"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="caster_swivel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="caster_fork"/>
    <origin xyz="-0.12 0 0.065" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.2" velocity="100.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="caster_wheel_link">
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00004" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.025" length="0.025"/></geometry>
      <material name="wheel_black"/>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.025" length="0.025"/></geometry>
    </collision>
  </link>
  <joint name="caster_wheel_joint" type="continuous">
    <parent link="caster_fork"/>
    <child link="caster_wheel_link"/>
    <origin xyz="-0.03 0 -0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.2" velocity="100.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00015" iyz="0" izz="0.00015"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.045" length="0.045"/></geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="lidar_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.08 0 0.215" rpy="0 0 0"/>
  </joint>
</robot>
